# ========== MES 配置 ==========
MES_BASE_URL=http://mes.internal
MES_LOGIN_PATH=/Login.aspx
MES_USERNAME=mes_auto_user
MES_PASSWORD=your_password_here
MES_FACTORY=Auto_THA

# ========== 数据库 ==========
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mes_platform
